# PRIMARY host. OpenPak Xbox 360 profile data download server (x360-xedl): Live service 11 requests the security
# gateway tunnels to the primary's Traefik. Identity headers are trusted only with the gateway key.
[Unit]
Description=OpenPak Xbox 360 profile data download server (x360-xedl)

[Container]
ContainerName=openpak-x360-xedl
Image=ghcr.io/openpak/x360-xedl:latest
AutoUpdate=registry
Network=openpak.network
IP=10.89.2.206
Environment=X360_XEDL_ADDR=:10011
EnvironmentFile=%h/openpak/deploy/x360-gateway-key.env
ReadOnly=true
DropCapability=ALL
NoNewPrivileges=true
UserNS=keep-id:uid=100,gid=101

[Service]
Restart=always

[Install]
WantedBy=default.target
